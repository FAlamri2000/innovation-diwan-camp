# Copy to .env for local development (npm run dev reads it). Never commit .env.

# PostgreSQL. Add ?sslmode=require if your server needs TLS.
DATABASE_URL=postgresql://postgres@localhost:5432/diwan_camp

# SoWork API — an office OWNER's key with the admin team-analytics permission.
# Server-side only; never stored in the database or shown on a screen.
SOWORK_API_KEY=
# SOWORK_API_BASE=https://api.sowork.com/public

# First admin, created at start-up only while no active admin exists.
# They must replace this password at first sign-in.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# The SoWork sync runs inside the server every minute in production.
# In `npm run dev` it is off unless CAMP_SCHEDULER=on.
# CAMP_SCHEDULER=on

# Optional: lets an external scheduler POST /api/tick with header x-tick-secret.
# TICK_SECRET=

# Session cookies are Secure in production. Set false ONLY to test a
# production build over plain http on your own machine.
# COOKIE_SECURE=false
